# LLM provider for the analysis agent (기능4).
# OpenRouter routes via OpenAI-compatible API. If OPENROUTER_API_KEY is set,
# agent.chat() uses OpenRouter; otherwise it falls back to direct OpenAI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional app attribution for OpenRouter analytics
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=STAR-Bench AML Assistant

# Direct OpenAI fallback (used only if OPENROUTER_API_KEY is empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Memgraph (optional — graph analysis falls back to DuckDB+NetworkX if absent)
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
